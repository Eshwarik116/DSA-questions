class Solution {
    public int minimumDeletions(int[] nums) {
        int n = nums.length;
        int max = Integer.MIN_VALUE;
        int min = Integer.MAX_VALUE;

        int max_idx= 0;
        int min_idx = 0;
     

        for(int i=0;i<n;i++){
            if(nums[i]>max){
                max = nums[i];
                max_idx = i;
            }
            if(nums[i]<min){
                min = nums[i];
                min_idx =i;
            }
        }

           int a = Math.max(max_idx,min_idx);
        int b = Math.min(max_idx,min_idx);
        int left = a+1;
        int right = n-b;
        int both = (b+1)+(n-a);

        int minways = Math.min(Math.min(left,right),both);
        return minways;
    }
}