class Solution {
    public String lexGreaterPermutation(String s, String target) {
        int n = s.length();
        int[] freq = new int[26];

        //count all characters or freq of s
        for(int i=0 ; i<n; i++){
            freq[s.charAt(i) - 'a']++;
        }

        StringBuilder ans = new StringBuilder();

        //phase 1:try to keep ans equal to target as long as possible
        for(int i =0;i<n;i++){
            int ch = target.charAt(i)-'a';
            if(freq[ch] > 0){
                ans.append((char)('a'+ch));
                freq[ch]--;
                continue;
            }
            for(int j = ch+1;j<26;j++){
                if(freq[j]>0){
                    ans.append((char)('a'+j));
                    freq[j]--;

                        for(int k=0;k<26;k++){
                            while(freq[k]>0){
                                ans.append((char)('a'+k));
                                freq[k]--;
                            }
                        }
                        return ans.toString();
                }
            }
            break;
        }
        //phase 2:go backwards and try to increase earlier character
        for(int i=ans.length()-1;i>=0;i--){
            int current = ans.charAt(i)-'a';
            freq[current]++;
            for(int j= current + 1;j<26;j++){
                if(freq[j]>0){

                    StringBuilder res = new StringBuilder(ans.substring(0,i));
                    res.append((char)('a'+j));
                    freq[j]--;

                    for(int k = 0;k<26;k++){
                        while(freq[k]>0){
                            res.append((char)('a'+k));
                            freq[k]--;
                        }
                    }
                    return res.toString();
                }
            }
        }
        return "";
    }
}